    },
    "qwen": {
      "formats": ["chat", "anthropic", "responses"],
      "min_context": 32000,
      "needs": ["tools"]
    },
    "kimi": {
      "formats": ["anthropic", "chat", "responses"],
      "min_context": 32000,
      "needs": ["tools"]
    },
    "pi": {
      "formats": ["anthropic", "chat", "responses"],
      "min_context": 32000,
      "needs": ["tools"]
    },
    "hermes": {
      "formats": ["chat", "anthropic", "responses"],
      "min_context": 64000,
      "min_context_hard": 64000,
      "needs": ["tools"],
      "notes": "Hermes refuses models under 64k context.",
