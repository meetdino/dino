{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "cloud": {
      "root": "crates/server",
      "runtime": "rust",
      "entrypoint": "src/main.rs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "cloud"
      }
    }
  ],
  "crons": [
    {
      "path": "/internal/cron",
      "schedule": "17 4 * * *"
    }
  ]
}
