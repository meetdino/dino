{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cloud": {
      "root": "crates/server",
      "entrypoint": "src/main.rs"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "cloud" } }],
  "crons": [{ "path": "/internal/cron", "schedule": "17 4 * * *" }]
}
