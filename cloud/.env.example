# Where people reach this server. Links, redirects and the OAuth issuer are built from it.
# dino's own is https://cloud.meetdino.com (API, sign-in and account pages on one host); this is
# for running it locally.
DINO_CLOUD_URL=http://127.0.0.1:8787
DINO_BIND=127.0.0.1:8787
# Prometheus /metrics on its own address (leave unset to turn it off).
DINO_METRICS_BIND=127.0.0.1:9464
DATABASE_URL=postgres://dino@127.0.0.1:55432/dino_cloud

# 32 random bytes, base64: openssl rand -base64 32. Required in production.
DINO_SECRET_KEY=
# production: requires https, the secret key and a mail API; JSON logs.
DINO_ENV=development
# Behind a load balancer or Cloudflare: take the client address from the header they set.
DINO_TRUST_PROXY=0

# Sign in with GitHub / Google: set both to turn each on. Every URL can be overridden.
DINO_GITHUB_CLIENT_ID=
DINO_GITHUB_CLIENT_SECRET=
DINO_GOOGLE_CLIENT_ID=
DINO_GOOGLE_CLIENT_SECRET=

# Email codes. Development: written to this file. Production: a mail API taking
# {from, to, subject, text} with a bearer key (Resend's shape; a key alone means Resend).
DINO_MAIL_LOG=dino-cloud-mail.log
DINO_MAIL_URL=
DINO_MAIL_KEY=
DINO_MAIL_FROM=dino <no-reply@example.com>

# Cloudflare Turnstile on the email form (off unless both are set).
DINO_TURNSTILE_SITE_KEY=
DINO_TURNSTILE_SECRET=

# Shared secret the harness presents to /oauth/introspect.
DINO_INTROSPECT_SECRET=

# Rate limits: requests per second,burst.
DINO_IP_LIMIT=30,120
DINO_ACCOUNT_LIMIT=20,60

# Push: a WebSocket per device, nudged through Postgres LISTEN/NOTIFY. On by default; off on Vercel
# (VERCEL=1), where devices look every minute instead.
DINO_PUSH=1
# Limits on sign-in attempts and sync writes counted in Postgres, for hosts with many instances.
# Default: on with VERCEL=1.
DINO_SHARED_LIMITS=0
# The cleanup job inside the server. Off on Vercel, where Vercel Cron calls /internal/cron with
# CRON_SECRET instead.
DINO_BACKGROUND_JOBS=1
CRON_SECRET=
# A direct (unpooled) database URL for migrations, when DATABASE_URL goes through a pooler
# (Neon's integration sets it).
DATABASE_URL_UNPOOLED=
DINO_DB_MAX_CONNECTIONS=32
